rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }
    function controls() {
      return get(/databases/$(database)/documents/settings/control).data;
    }
    function mailWorker() {
      return request.auth != null && request.auth.uid == 'cancellation-mail-worker' &&
        request.auth.token.get('cancellationMailWorker',false) == true;
    }
    function approved() {
      return request.auth != null &&
        get(userPath()).data.active == true &&
        get(userPath()).data.role in ['teacher', 'admin'];
    }
    function cancellationRecorded(id, booking) {
      return booking.ownerUid == request.auth.uid ||
        (!exists(/databases/$(database)/documents/cancellationNotifications/$(id)) &&
         existsAfter(/databases/$(database)/documents/cancellationNotifications/$(id)));
    }
    function mayCancel(booking) {
      return booking.ownerUid == request.auth.uid || get(userPath()).data.get('canCancelAll', false) == true;
    }
    function elevated() { return get(userPath()).data.get('canCancelAll',false) == true; }
    function reportingWorker() {
      return request.auth != null && request.auth.uid == 'reporting-worker' && request.auth.token.get('reportingWorker',false) == true;
    }
    function activityRecorded(id,suffix) {
      let path=/databases/$(database)/documents/activityEvents/$(id + suffix);
      return controls().get('auditLoggingRequired',false) != true ||
        (existsAfter(path) && getAfter(path).data.occurredAt == request.time);
    }
    function adminEmailRetry() {
      return approved() && elevated() && resource.data.status == 'failed' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','attempts','retryRequestedAt','retryRequestedBy']) &&
        request.resource.data.status == 'pending' && request.resource.data.attempts == 0 &&
        request.resource.data.retryRequestedAt == request.time && request.resource.data.retryRequestedBy == request.auth.uid;
    }
    function validStudentEmails(list) {
      return list is list && list.size() <= 100 && list.toSet().size() == list.size() &&
        (list.size() == 0 || list.join(';').matches("^[a-z0-9!#$%&'*+/=?^_`{|}~-]+([.][a-z0-9!#$%&'*+/=?^_`{|}~-]+)*@student[.]uni-pr[.]edu(;[a-z0-9!#$%&'*+/=?^_`{|}~-]+([.][a-z0-9!#$%&'*+/=?^_`{|}~-]+)*@student[.]uni-pr[.]edu)*$"));
    }
    function studentList(booking,id) {
      let path=/databases/$(database)/documents/studentNotifications/$(id);
      return 'studentEmails' in booking ? booking.studentEmails : (exists(path) ? get(path).data.recipients : []);
    }
    function sameSchedule(a,b) { return a.date == b.date && a.roomId == b.roomId && a.periodIds == b.periodIds; }
    function specialRoom(id) { return id in ['r_9c3ca97a27ce','r_a8ae63f60a13']; }
    function approvedRequest(id, booking) {
      let path = /databases/$(database)/documents/reservationRequests/$(id);
      let decision = /databases/$(database)/documents/requestDecisions/$(id);
      return elevated() && getAfter(decision).data.outcome == 'approved' &&
        !existsAfter(path) && booking.diff(get(path).data).affectedKeys().hasOnly(['createdAt']);
    }
    function mayCreate(id, booking) {
      return (booking.ownerUid == request.auth.uid && booking.creatorName == request.auth.token.get('name','Mësimdhënës') &&
        (!specialRoom(booking.roomId) || elevated())) || approvedRequest(id,booking);
    }
    function canBook(date) {
      return approved() && controls().bookingOpen == true && controls().slotStorage == 'resources-v2' &&
        date >= controls().startDate && date <= controls().endDate &&
        dayAllowed(date);
    }
    function dayPath(date) {
      return /databases/$(database)/documents/calendarDays/$(date);
    }
    function dayAllowed(date) {
      return get(dayPath(date)).data.bookingAllowed == true;
    }
    function catalog() { return get(/databases/$(database)/documents/resourceCatalog/current).data; }
    function resources(d) {
      return d.get('groupIds', []).concat(d.get('teacherIds', [])).concat(d.roomId == '' ? [] : [d.roomId]);
    }
    function periodKeys(ids, suffix) {
      return ids.join(suffix + '|') + suffix;
    }
    function keys(d) {
      let ids = resources(d);
      let p = d.periodIds;
      let n = p.size();
      return ids.size() == 0 ? [] : [
        n > 0 ? periodKeys(ids, '__' + p[0]) : '',
        n > 1 ? periodKeys(ids, '__' + p[1]) : '',
        n > 2 ? periodKeys(ids, '__' + p[2]) : '',
        n > 3 ? periodKeys(ids, '__' + p[3]) : '',
        n > 4 ? periodKeys(ids, '__' + p[4]) : '',
        n > 5 ? periodKeys(ids, '__' + p[5]) : '',
        n > 6 ? periodKeys(ids, '__' + p[6]) : '',
        n > 7 ? periodKeys(ids, '__' + p[7]) : '',
        n > 8 ? periodKeys(ids, '__' + p[8]) : '',
        n > 9 ? periodKeys(ids, '__' + p[9]) : '',
        n > 10 ? periodKeys(ids, '__' + p[10]) : '',
        n > 11 ? periodKeys(ids, '__' + p[11]) : '',
        n > 12 ? periodKeys(ids, '__' + p[12]) : '',
        n > 13 ? periodKeys(ids, '__' + p[13]) : '',
        n > 14 ? periodKeys(ids, '__' + p[14]) : '',
        n > 15 ? periodKeys(ids, '__' + p[15]) : ''
      ].join('|').split('[|]').removeAll(['']);
    }
    function freeOfFet(d, expected) {
      let day = get(dayPath(d.date)).data;
      return !day.fetActive || !get(/databases/$(database)/documents/weeklyResources/$(day.weekday)).data.busyKeys.hasAny(expected);
    }
    function valid(d) {
      return d.keys().hasOnly(['title','date','roomId','periodIds','ownerUid','creatorName','createdAt','groupIds','teacherIds','eventType','isPublic','mode','onlineUrl','location','description','revision','updatedAt','studentEmails']) &&
        validStudentEmails(d.get('studentEmails',[])) &&
        d.title is string && d.title.size() > 0 && d.title.size() <= 120 &&
        d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        d.roomId is string && (d.roomId == '' || d.roomId in catalog().rooms) &&
        d.groupIds is list && d.groupIds.toSet().size() == d.groupIds.size() && catalog().groups.keys().hasAll(d.groupIds) &&
        d.teacherIds is list && d.teacherIds.toSet().size() == d.teacherIds.size() && catalog().teachers.keys().hasAll(d.teacherIds) &&
        d.periodIds is list && d.periodIds.size() > 0 && d.periodIds.size() <= 16 &&
        controls().periodOrder.keys().hasAll(d.periodIds) && d.periodIds.join(',') in controls().validPeriodRanges &&
        d.eventType in ['Zëvendësim i mësimit','Konferencë','Panel','Mbrojtje publike','Mbledhje','Tryezë','Diskutim','Punëtori','Ligjëratë e ftuar','Ceremoni','Kolokium','Ekspozitë'] &&
        d.get('location','') is string && d.get('location','').size() <= 300 &&
        (d.get('location','') == '' || (d.roomId == '' && d.mode == 'physical')) &&
        d.get('description','') is string &&
        d.get('description','').split('\\s+').removeAll(['']).size() <= 500 &&
        (!d.isPublic || (d.get('description','').split('\\s+').removeAll(['']).size() >= 100 &&
          d.description.trim().replace('\\s+', ' ').lower() != d.title.trim().replace('\\s+', ' ').lower())) &&
        (d.isPublic || d.get('description','') == '') &&
        d.isPublic is bool && d.mode in ['physical','online'] && d.onlineUrl is string &&
        (d.mode == 'physical' ? d.onlineUrl == '' : (d.onlineUrl.size() <= 2000 && d.onlineUrl.matches('^https?://[^ /]+.*$')));
    }
    function occupancyChange(id, d, creating, expected) {
      let path = /databases/$(database)/documents/eventDays/$(d.date);
      let before = exists(path) ? get(path).data.bookings : {};
      let after = getAfter(path).data;
      let diff = after.bookings.diff(before);
      // Exact added/removed keys plus an unchanged count of non-id values
      // ensures every affected period belongs to this reservation. This avoids
      // 16 separate map-value checks and the 1000-expression evaluation limit.
      return after.changedReservationId == id &&
        (creating ?
          (diff.addedKeys() == expected.toSet() && diff.changedKeys().size() == 0 && diff.removedKeys().size() == 0 &&
           after.bookings.values().removeAll([id]).size() == before.values().removeAll([id]).size()) :
          (diff.removedKeys() == expected.toSet() && diff.changedKeys().size() == 0 && diff.addedKeys().size() == 0 &&
           after.bookings.values().removeAll([id]).size() == before.values().removeAll([id]).size()));
    }
    function occupancyWritten(id, d) {
      let path = /databases/$(database)/documents/eventDays/$(d.date);
      return getAfter(path).data.changedReservationId == id &&
        (!exists(path) || getAfter(path).data.bookings != get(path).data.bookings);
    }
    function sameSlots(a,b) {
      return a.date == b.date && a.roomId == b.roomId && a.periodIds == b.periodIds &&
        a.get('groupIds',[]).toSet() == b.groupIds.toSet() && a.get('teacherIds',[]).toSet() == b.teacherIds.toSet();
    }
    function studentChangeRecorded(id, suffix) {
      let path=/databases/$(database)/documents/reservations/$(id);
      let before=get(path).data;
      let after=existsAfter(path) ? getAfter(path).data : before;
      return (studentList(before,id).size() == 0 && studentList(after,id).size() == 0) ||
        (!exists(/databases/$(database)/documents/studentChangeNotifications/$(id + suffix)) &&
         existsAfter(/databases/$(database)/documents/studentChangeNotifications/$(id + suffix)));
    }
    function modificationRecorded(id, before, after) {
      let path = /databases/$(database)/documents/modificationNotifications/$(id + '__' + string(after.revision));
      return existsAfter(path);
    }
    function editOccupancy(id, before, after) {
      return sameSlots(before,after) ||
        ((resources(before).size() == 0 || occupancyWritten(id,before)) &&
         (resources(after).size() == 0 || occupancyWritten(id,after)));
    }
    function occupancyEdit(id, before, after, date) {
      let notice = /databases/$(database)/documents/modificationNotifications/$(id + '__' + string(after.revision));
      let oldKeys = before.date == date ? getAfter(notice).data.previousKeys.toSet() : [].toSet();
      let newList = after.date == date ? keys(after) : [];
      let newKeys = newList.toSet();
      let path = /databases/$(database)/documents/eventDays/$(date);
      let oldMap = exists(path) ? get(path).data.bookings : {};
      let newMap = getAfter(path).data.bookings;
      let diff = newMap.diff(oldMap);
      return (date == before.date || date == after.date) &&
        diff.addedKeys() == newKeys.difference(oldKeys) && diff.removedKeys() == oldKeys.difference(newKeys) &&
        diff.changedKeys().size() == 0 &&
        newMap.values().removeAll([id]).size() == oldMap.values().removeAll([id]).size() &&
        (date != after.date || freeOfFet(after, newList));
    }
    function publicMatches(id, d) {
      let p = getAfter(/databases/$(database)/documents/publicBookings/$(id)).data;
      return !p.keys().hasAny(['ownerUid','studentEmails']) && d.diff(p).affectedKeys() == (d.keys().hasAny(['studentEmails']) ? ['ownerUid','studentEmails'].toSet() : ['ownerUid'].toSet());
    }
    match /resourceCatalog/{id} { allow read: if true; allow write: if false; }
    match /weeklyResources/{id} { allow read: if approved(); allow write: if false; }
    match /users/{uid} {
      allow get: if (request.auth != null && request.auth.uid == uid) || mailWorker();
      allow list, create, update, delete: if false;
    }
    match /settings/{key} {
      allow get: if approved();
      allow list, write: if false;
    }
    match /rooms/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /periods/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /calendarDays/{date} {
      allow get: if true;
      allow list: if approved();
      allow write: if false;
    }
    match /weeklyRooms/{key} {
      allow read: if approved();
      allow write: if false;
    }
    match /reservations/{reservationId} {
      allow get: if approved() && !exists(/databases/$(database)/documents/reservations/$(reservationId));
      allow read: if approved() && (resource.data.ownerUid == request.auth.uid || elevated());
      allow create: if canBook(request.resource.data.date) && valid(request.resource.data) &&
        mayCreate(reservationId,request.resource.data) &&
        activityRecorded(reservationId,'__created') &&
        request.resource.data.createdAt == request.time && !request.resource.data.keys().hasAny(['revision','updatedAt']) &&
        (resources(request.resource.data).size() == 0 || occupancyWritten(reservationId, request.resource.data)) &&
        publicMatches(reservationId, request.resource.data);
      allow update: if canBook(request.resource.data.date) && mayCancel(resource.data) && valid(request.resource.data) &&
        activityRecorded(reservationId,'__edit__' + string(request.resource.data.revision)) &&
        (elevated() || (!(specialRoom(resource.data.roomId) || specialRoom(request.resource.data.roomId))) || sameSchedule(resource.data,request.resource.data)) &&
        request.resource.data.ownerUid == resource.data.ownerUid && request.resource.data.creatorName == resource.data.creatorName &&
        request.resource.data.createdAt == resource.data.createdAt && request.resource.data.updatedAt == request.time &&
        (!('studentEmails' in resource.data) || 'studentEmails' in request.resource.data) &&
        request.resource.data.revision is int && request.resource.data.revision == resource.data.get('revision',0)+1 &&
        editOccupancy(reservationId,resource.data,request.resource.data) &&
        studentChangeRecorded(reservationId,'__edit__' + string(request.resource.data.revision)) && modificationRecorded(reservationId,resource.data,request.resource.data) && publicMatches(reservationId,request.resource.data);
      allow delete: if approved() && controls().bookingOpen == true &&
        activityRecorded(reservationId,'__cancelled') &&
        mayCancel(resource.data) && studentChangeRecorded(reservationId,'__cancel') && cancellationRecorded(reservationId, resource.data) &&
        controls().slotStorage == 'resources-v2' &&
        (resources(resource.data).size() == 0 || occupancyWritten(reservationId, resource.data)) &&
        !existsAfter(/databases/$(database)/documents/publicBookings/$(reservationId));
    }
    match /reservationRequests/{id} {
      allow read: if approved() && (elevated() || resource.data.ownerUid == request.auth.uid);
      allow create: if canBook(request.resource.data.date) && !elevated() && valid(request.resource.data) &&
        activityRecorded(id,'__requested') &&
        specialRoom(request.resource.data.roomId) && request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.creatorName == request.auth.token.get('name','Mësimdhënës') &&
        request.resource.data.createdAt == request.time && !request.resource.data.keys().hasAny(['revision','updatedAt']) &&
        !exists(/databases/$(database)/documents/requestNotifications/$(id)) &&
        existsAfter(/databases/$(database)/documents/requestNotifications/$(id));
      allow update: if false;
      allow delete: if approved() && elevated() && existsAfter(/databases/$(database)/documents/requestDecisions/$(id)) &&
        activityRecorded(id,getAfter(/databases/$(database)/documents/requestDecisions/$(id)).data.outcome == 'approved' ? '__approved' : '__declined');
    }
    match /reservationEditRequests/{id} {
      allow read: if approved() && (elevated() || resource.data.ownerUid == request.auth.uid);
      function validEditRequest() {
        let d=request.resource.data;
        let before=get(/databases/$(database)/documents/reservations/$(d.reservationId)).data;
        return d.keys().hasOnly(['reservationId','expectedRevision','booking','ownerUid','createdAt']) &&
          d.ownerUid == request.auth.uid && before.ownerUid == request.auth.uid &&
          d.expectedRevision == before.get('revision',0) && d.createdAt == request.time &&
          valid(d.booking) && d.booking.ownerUid == before.ownerUid && d.booking.creatorName == before.creatorName && d.booking.createdAt == before.createdAt &&
          (specialRoom(before.roomId) || specialRoom(d.booking.roomId)) && !sameSchedule(before,d.booking) &&
          !exists(/databases/$(database)/documents/requestDecisions/$(id)) &&
          getAfter(/databases/$(database)/documents/requestNotifications/$(id)).data.booking == d.booking;
      }
      allow create: if approved() && !elevated() && canBook(request.resource.data.booking.date) && validEditRequest() && activityRecorded(id,'__requested');
      allow update: if false;
      allow delete: if approved() && elevated() && getAfter(/databases/$(database)/documents/requestDecisions/$(id)).data.reservationId == resource.data.reservationId &&
        activityRecorded(id,getAfter(/databases/$(database)/documents/requestDecisions/$(id)).data.outcome == 'approved' ? '__approved' : '__declined');
    }
    match /requestNotifications/{id} {
      allow create: if approved() &&
        request.resource.data.keys().hasOnly(['booking','kind','status','createdAt']) &&
        request.resource.data.kind == 'request-submitted' && request.resource.data.status == 'pending' &&
        request.resource.data.createdAt == request.time &&
        !exists(/databases/$(database)/documents/requestDecisions/$(id)) &&
        ((!exists(/databases/$(database)/documents/reservationRequests/$(id)) && request.resource.data.booking == getAfter(/databases/$(database)/documents/reservationRequests/$(id)).data) ||
         (!exists(/databases/$(database)/documents/reservationEditRequests/$(id)) && request.resource.data.booking == getAfter(/databases/$(database)/documents/reservationEditRequests/$(id)).data.booking)) &&
        request.resource.data.booking.ownerUid == request.auth.uid;
      allow read: if mailWorker() || (approved() && (elevated() || resource.data.booking.ownerUid == request.auth.uid));
      allow update: if adminEmailRetry();
      allow update: if mailWorker() && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'status','attempts','leaseToken','leaseUntil','sentAt','lastErrorCode','lastAttemptAt'
      ]) && request.resource.data.status in ['sending','sent','retrying','failed'];
      allow delete: if false;
    }
    match /requestDecisions/{id} {
      function validDecision() {
        let d = request.resource.data;
        let editing='reservationId' in d;
        let path = editing ? /databases/$(database)/documents/reservationEditRequests/$(id) : /databases/$(database)/documents/reservationRequests/$(id);
        let reservation = editing ? /databases/$(database)/documents/reservations/$(d.reservationId) : /databases/$(database)/documents/reservations/$(id);
        return d.keys().hasOnly(['booking','outcome','reason','decidedBy','deciderName','createdAt','status','reservationId']) &&
          d.booking == (editing ? get(path).data.booking : get(path).data) && !existsAfter(path) && d.status == 'pending' &&
          d.decidedBy == request.auth.uid && d.deciderName == request.auth.token.get('name','Mësimdhënës') && d.createdAt == request.time &&
          d.reason is string && d.reason.size() <= 2000 && d.reason.matches('(?s).*\\S.*') &&
          (editing ?
            (d.reservationId == get(path).data.reservationId &&
             (d.outcome == 'approved' ? (get(reservation).data.get('revision',0) == get(path).data.expectedRevision && getAfter(reservation).data.revision == get(path).data.expectedRevision+1 && getAfter(reservation).data.diff(d.booking).affectedKeys().hasOnly(['revision','updatedAt'])) :
              (d.outcome == 'rejected' && (exists(reservation) ? getAfter(reservation).data == get(reservation).data : !existsAfter(reservation))))) :
            (d.outcome == 'approved' ? (!exists(reservation) && getAfter(reservation).data.diff(d.booking).affectedKeys().hasOnly(['createdAt'])) :
             (d.outcome == 'rejected' && !existsAfter(reservation))));
      }
      allow read: if mailWorker() || (approved() && (resource.data.booking.ownerUid == request.auth.uid || elevated()));
      allow create: if approved() && elevated() && validDecision();
      allow update: if adminEmailRetry();
      allow update: if mailWorker() && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'status','attempts','leaseToken','leaseUntil','sentAt','lastErrorCode','lastAttemptAt'
      ]) && request.resource.data.status in ['sending','sent','retrying','failed'];
      allow delete: if false;
    }
    match /modificationNotifications/{id} {
      function validModification() {
        let d = request.resource.data;
        let path = /databases/$(database)/documents/reservations/$(d.reservationId);
        let before = get(path).data;
        let after = getAfter(path).data;
        return d.keys().hasOnly(['reservationId','before','booking','previousKeys','modifiedBy','modifierName','createdAt','status']) &&
          mayCancel(before) && d.previousKeys is list && d.previousKeys.toSet() == keys(before).toSet() &&
          d.before == before && d.booking == after && after.revision == before.get('revision',0)+1 &&
          id == d.reservationId + '__' + string(after.revision) && d.modifiedBy == request.auth.uid &&
          d.modifierName == request.auth.token.get('name','Mësimdhënës') && d.createdAt == request.time &&
          d.status == (before.ownerUid == request.auth.uid ? 'recorded' : 'pending');
      }
      allow create: if approved() && controls().bookingOpen && validModification();
      allow read: if mailWorker() || (approved() && (resource.data.booking.ownerUid == request.auth.uid || get(userPath()).data.get('canCancelAll',false)));
      allow update: if adminEmailRetry();
      allow update: if mailWorker() && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'status','attempts','leaseToken','leaseUntil','sentAt','lastErrorCode','lastAttemptAt'
      ]) && request.resource.data.status in ['sending','sent','retrying','failed'];
      allow delete: if false;
    }
    // Student addresses are private and never included in publicBookings.
    match /studentChangeNotifications/{id} {
      function validChange() {
        let d=request.resource.data;
        let path=/databases/$(database)/documents/reservations/$(d.reservationId);
        let before=get(path).data;
        return d.keys().hasOnly(['reservationId','booking','before','recipients','kind','eventAction','reason','status','createdAt']) &&
          controls().bookingOpen && mayCancel(before) && d.kind == 'students' &&
          d.status == (d.recipients.size() > 0 ? 'pending' : 'skipped') && d.createdAt == request.time &&
          d.recipients == studentList(d.eventAction == 'modified' ? getAfter(path).data : before,d.reservationId) &&
          (d.eventAction == 'modified' ?
            (d.before == before && d.booking == getAfter(path).data && d.booking.revision == before.get('revision',0)+1 && id == d.reservationId + '__edit__' + string(d.booking.revision)) :
            (d.eventAction == 'cancelled' && d.booking == before && !existsAfter(path) && id == d.reservationId + '__cancel' && d.reason is string && d.reason.size() <= 2000));
      }
      allow create: if approved() && validChange();
      allow read: if mailWorker() || (approved() && (resource.data.booking.ownerUid == request.auth.uid || elevated()));
      allow update: if adminEmailRetry();
      allow update: if mailWorker() && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'status','attempts','leaseToken','leaseUntil','sentAt','sentRecipients','recipientSentAt','lastErrorCode','lastAttemptAt'
      ]) && request.resource.data.status in ['sending','sent','retrying','failed','skipped'];
      allow delete: if false;
    }
    match /studentNotifications/{id} {
      allow get: if approved() && (elevated() || mayCancel(get(/databases/$(database)/documents/reservations/$(id)).data));
      allow get: if approved() && !exists(/databases/$(database)/documents/studentNotifications/$(id)) &&
        mayCancel(get(/databases/$(database)/documents/reservations/$(id)).data);
      function validStudents() {
        let d=request.resource.data;
        let source=d.status == 'pending' ? /databases/$(database)/documents/reservations/$(id) : /databases/$(database)/documents/reservationRequests/$(id);
        return d.keys().hasOnly(['booking','recipients','kind','status','createdAt']) &&
          d.kind == 'students' && d.status in ['pending','awaiting-approval'] &&
          d.createdAt == request.time && !exists(source) && d.booking == getAfter(source).data &&
          (!('studentEmails' in d.booking) || d.recipients == d.booking.studentEmails) &&
          d.recipients is list && d.recipients.size() > 0 && d.recipients.size() <= 100 &&
          d.recipients.toSet().size() == d.recipients.size() &&
          d.recipients.join(';').matches("^[a-z0-9!#$%&'*+/=?^_`{|}~-]+([.][a-z0-9!#$%&'*+/=?^_`{|}~-]+)*@student[.]uni-pr[.]edu(;[a-z0-9!#$%&'*+/=?^_`{|}~-]+([.][a-z0-9!#$%&'*+/=?^_`{|}~-]+)*@student[.]uni-pr[.]edu)*$");
      }
      allow create: if approved() && validStudents();
      allow read: if mailWorker() || (approved() && (resource.data.booking.ownerUid == request.auth.uid || elevated()));
      allow update: if approved() && elevated() && resource.data.status == 'awaiting-approval' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
        request.resource.data.status == (getAfter(/databases/$(database)/documents/requestDecisions/$(id)).data.outcome == 'approved' ? 'pending' : 'cancelled');
      allow update: if adminEmailRetry();
      allow update: if mailWorker() && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'status','attempts','leaseToken','leaseUntil','sentAt','sentRecipients','recipientSentAt','lastErrorCode','lastAttemptAt'
      ]) && request.resource.data.status in ['sending','sent','retrying','failed','skipped'];
      allow delete: if false;
    }
    match /mailSettings/{id} {
      allow get: if (mailWorker() || (approved() && elevated())) && id == 'publicEvents';
      allow list, write: if false;
    }
    match /publicEventRecipients/{id} {
      allow read: if mailWorker() || (approved() && elevated());
      allow create: if mailWorker() &&
        request.resource.data.keys().hasOnly(['recipient','unsubscribeToken','unsubscribed']) &&
        request.resource.data.recipient in get(/databases/$(database)/documents/mailSettings/publicEvents).data.recipients &&
        request.resource.data.unsubscribeToken is string && request.resource.data.unsubscribeToken.size() >= 32 &&
        request.resource.data.unsubscribed == false;
      // A bearer token authorizes only opting out. No public reads, address
      // changes, token changes, resubscriptions or arbitrary writes are allowed.
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unsubscribed','unsubscribedAt','confirmationToken']) &&
        request.resource.data.confirmationToken == resource.data.unsubscribeToken &&
        request.resource.data.unsubscribed == true && request.resource.data.unsubscribedAt == request.time;
      allow delete: if false;
    }
    match /publicEventWeeks/{week} {
      allow read: if mailWorker() || (approved() && elevated());
      allow create: if mailWorker() && request.resource.data.keys().hasOnly(['weekStart','bookingIds','createdAt']) &&
        request.resource.data.weekStart == week && request.resource.data.bookingIds is list;
      allow update, delete: if false;
    }
    match /publicEventDeliveries/{id} {
      allow read: if mailWorker() || (approved() && elevated());
      allow update: if adminEmailRetry() && ('weekStart' in resource.data || get(/databases/$(database)/documents/publicBookings/$(resource.data.bookingId)).data.isPublic == true);
      allow create: if mailWorker() &&
        request.resource.data.weekStart is string && request.resource.data.bookingIds is list &&
        exists(/databases/$(database)/documents/publicEventWeeks/$(request.resource.data.weekStart)) &&
        request.resource.data.recipient in get(/databases/$(database)/documents/mailSettings/publicEvents).data.recipients;
      allow update: if mailWorker() && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'status','attempts','leaseToken','leaseUntil','sentAt','createdAt','lastErrorCode','lastAttemptAt','bookingIds'
      ]);
      allow delete: if false;
    }
    match /cancellationNotifications/{id} {
      function validCancellation() {
        let d = request.resource.data;
        let path = /databases/$(database)/documents/reservations/$(id);
        let booking = get(path).data;
        return d.keys().hasOnly(['booking','reason','cancelledBy','createdAt','status']) &&
          booking.ownerUid != request.auth.uid && mayCancel(booking) &&
          d.booking == booking && !existsAfter(path) &&
          d.cancelledBy == request.auth.uid && d.createdAt == request.time && d.status == 'pending' &&
          d.reason is string && d.reason.size() <= 2000 && d.reason.matches('(?s).*\\S.*');
      }
      allow create: if approved() && controls().bookingOpen && validCancellation();
      allow read: if mailWorker() || (approved() && (resource.data.booking.ownerUid == request.auth.uid || get(userPath()).data.get('canCancelAll',false)));
      allow update: if adminEmailRetry();
      allow update: if mailWorker() && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'status','attempts','leaseToken','leaseUntil','sentAt','lastErrorCode','lastAttemptAt'
      ]) && request.resource.data.status in ['sending','sent','retrying','failed'];
      allow delete: if false;
    }
    match /publicBookings/{id} {
      allow read: if true;
      allow create: if approved() &&
        mayCreate(id,getAfter(/databases/$(database)/documents/reservations/$(id)).data) &&
        publicMatches(id, getAfter(/databases/$(database)/documents/reservations/$(id)).data);
      allow update: if approved() && mayCancel(get(/databases/$(database)/documents/reservations/$(id)).data) &&
        getAfter(/databases/$(database)/documents/reservations/$(id)).data.revision == get(/databases/$(database)/documents/reservations/$(id)).data.get('revision',0)+1 &&
        publicMatches(id,getAfter(/databases/$(database)/documents/reservations/$(id)).data);
      allow delete: if approved() && controls().bookingOpen == true &&
        mayCancel(get(/databases/$(database)/documents/reservations/$(id)).data) &&
        !existsAfter(/databases/$(database)/documents/reservations/$(id));
    }
    match /eventDays/{key} {
      allow read: if approved();
      function editing() {
        let id = request.resource.data.changedReservationId;
        let path = /databases/$(database)/documents/reservations/$(id);
        return exists(path) && existsAfter(path);
      }
      function validEdit() {
        let id = request.resource.data.changedReservationId;
        let path = /databases/$(database)/documents/reservations/$(id);
        let before = get(path).data;
        let after = getAfter(path).data;
        return mayCancel(before) && after.revision == before.get('revision',0)+1 && occupancyEdit(id,before,after,key);
      }
      function validChange() {
        let id = request.resource.data.changedReservationId;
        let path = /databases/$(database)/documents/reservations/$(id);
        let creating = !exists(path);
        let booking = creating ? getAfter(path).data : get(path).data;
        let expected = keys(booking);
        return key == booking.date && resources(booking).size() > 0 &&
          (creating ? (booking.ownerUid == request.auth.uid || elevated()) : mayCancel(booking)) &&
          (creating ? existsAfter(path) : !existsAfter(path)) &&
          occupancyChange(id, booking, creating, expected) && (!creating || freeOfFet(booking, expected));
      }
      allow create, update: if approved() && controls().bookingOpen == true &&
        controls().slotStorage == 'resources-v2' &&
        request.resource.data.keys().hasOnly(['bookings', 'changedReservationId']) &&
        request.resource.data.bookings is map &&
        request.resource.data.changedReservationId is string && (editing() ? validEdit() : validChange());
      allow delete: if false;
    }
    match /roomDays/{key} { allow read: if approved(); allow write: if false; }
    // Immutable action records. Neither ordinary users nor managers can rewrite history.
    match /activityEvents/{id} {
      function matches(d,booking) {
        return d.ownerUid == booking.ownerUid && d.title == booking.title && d.activityDate == booking.date && d.revision == booking.get('revision',0);
      }
      function created(d) {
        let path=/databases/$(database)/documents/reservations/$(d.entityId);
        let booking=getAfter(path).data;
        let decision=/databases/$(database)/documents/requestDecisions/$(d.entityId);
        return id == d.entityId + '__created' && !exists(path) && matches(d,booking) && d.requestedAt == null &&
          (d.method == 'direct' ? (booking.ownerUid == request.auth.uid && !exists(/databases/$(database)/documents/reservationRequests/$(d.entityId))) :
            (d.method == 'approved' && elevated() && getAfter(decision).data.outcome == 'approved' &&
              getAfter(decision).data.decidedBy == request.auth.uid && getAfter(decision).data.createdAt == request.time));
      }
      function edited(d) {
        let path=/databases/$(database)/documents/reservations/$(d.entityId);
        let before=get(path).data;
        let after=getAfter(path).data;
        return id == d.entityId + '__edit__' + string(d.revision) && mayCancel(before) && matches(d,after) &&
          after.revision == before.get('revision',0)+1 && d.method == '' && d.requestedAt == null;
      }
      function cancelled(d) {
        let path=/databases/$(database)/documents/reservations/$(d.entityId);
        return id == d.entityId + '__cancelled' && matches(d,get(path).data) && mayCancel(get(path).data) &&
          !existsAfter(path) && d.method == '' && d.requestedAt == null;
      }
      function requested(d) {
        let path=/databases/$(database)/documents/reservationRequests/$(d.entityId);
        let edit=/databases/$(database)/documents/reservationEditRequests/$(d.entityId);
        return id == d.entityId + '__requested' && !exists(path) && !exists(edit) && (existsAfter(edit) ? matches(d,getAfter(edit).data.booking) : matches(d,getAfter(path).data)) &&
          d.ownerUid == request.auth.uid && d.method == '' && d.requestedAt == null;
      }
      function decided(d) {
        let decision=getAfter(/databases/$(database)/documents/requestDecisions/$(d.entityId)).data;
        let editing='reservationId' in decision;
        let path=editing ? /databases/$(database)/documents/reservationEditRequests/$(d.entityId) : /databases/$(database)/documents/reservationRequests/$(d.entityId);
        return elevated() && id == d.entityId + (d.kind == 'approved' ? '__approved' : '__declined') &&
          matches(d,editing ? get(path).data.booking : get(path).data) && !existsAfter(path) && d.requestedAt == get(path).data.createdAt && d.method == '' &&
          decision.decidedBy == request.auth.uid && decision.createdAt == request.time &&
          decision.outcome == (d.kind == 'approved' ? 'approved' : 'rejected');
      }
      allow read: if approved() && elevated();
      allow create: if approved() && request.resource.data.keys().hasOnly(['kind','entityId','ownerUid','actorUid','occurredAt','activityDate','title','revision','method','requestedAt','source']) &&
        request.resource.data.actorUid == request.auth.uid && request.resource.data.source == 'app' &&
        request.resource.data.occurredAt == request.time && request.resource.data.entityId is string &&
        request.resource.data.revision is int && request.resource.data.revision >= 0 &&
        (request.resource.data.kind == 'created' ? created(request.resource.data) :
         request.resource.data.kind == 'edited' ? edited(request.resource.data) :
         request.resource.data.kind == 'cancelled' ? cancelled(request.resource.data) :
         request.resource.data.kind == 'requested' ? requested(request.resource.data) :
         request.resource.data.kind in ['approved','declined'] && decided(request.resource.data));
      allow update, delete: if false;
    }
    match /timetableImports/{id} { allow read: if approved() && elevated(); allow write: if false; }
    match /trafficDaily/{date} {
      allow read: if approved() && elevated();
      allow create, update: if reportingWorker() && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        request.resource.data.keys().hasOnly(['visits','pageViews','paths','complete','source','updatedAt','timezone','sampled']) &&
        request.resource.data.visits is number && request.resource.data.visits >= 0 &&
        request.resource.data.pageViews is number && request.resource.data.pageViews >= 0 &&
        request.resource.data.paths is list && request.resource.data.paths.size() <= 500 &&
        request.resource.data.complete is bool && request.resource.data.source == 'cloudflare' &&
        request.resource.data.timezone == 'Europe/Tirane' && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /reportSettings/{id} {
      allow read: if approved() && elevated();
      allow create, update: if reportingWorker() && id == 'traffic' &&
        request.resource.data.keys().hasOnly(['status','updatedAt','lastSuccessAt','lastCompleteDate','errorCode','hostname']) &&
        request.resource.data.status in ['ready','error'] && request.resource.data.hostname == 'filozofiku.github.io' &&
        request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    // Historical per-period locks are retained for reference; daily locks are authoritative.
    match /roomSlots/{slotId} {
      allow read: if approved();
      allow write: if false;
    }
  }
}
