rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }
    function controls() {
      return get(/databases/$(database)/documents/settings/control).data;
    }
    function mailWorker() {
      return request.auth != null && request.auth.uid == 'cancellation-mail-worker' &&
        request.auth.token.get('cancellationMailWorker',false) == true;
    }
    function approved() {
      return request.auth != null &&
        get(userPath()).data.active == true &&
        get(userPath()).data.role in ['teacher', 'admin'];
    }
    function cancellationRecorded(id, booking) {
      return booking.ownerUid == request.auth.uid ||
        (!exists(/databases/$(database)/documents/cancellationNotifications/$(id)) &&
         existsAfter(/databases/$(database)/documents/cancellationNotifications/$(id)));
    }
    function mayCancel(booking) {
      return booking.ownerUid == request.auth.uid || get(userPath()).data.get('canCancelAll', false) == true;
    }
    function canBook(date) {
      return approved() && controls().bookingOpen == true && controls().slotStorage == 'resources-v2' &&
        date >= controls().startDate && date <= controls().endDate &&
        dayAllowed(date);
    }
    function dayPath(date) {
      return /databases/$(database)/documents/calendarDays/$(date);
    }
    function dayAllowed(date) {
      return get(dayPath(date)).data.bookingAllowed == true;
    }
    function catalog() { return get(/databases/$(database)/documents/resourceCatalog/current).data; }
    function resources(d) {
      return d.get('groupIds', []).concat(d.get('teacherIds', [])).concat(d.roomId == '' ? [] : [d.roomId]);
    }
    function periodKeys(ids, suffix) {
      return ids.join(suffix + '|') + suffix;
    }
    function keys(d) {
      let ids = resources(d);
      let p = d.periodIds;
      let n = p.size();
      return ids.size() == 0 ? [] : [
        n > 0 ? periodKeys(ids, '__' + p[0]) : '',
        n > 1 ? periodKeys(ids, '__' + p[1]) : '',
        n > 2 ? periodKeys(ids, '__' + p[2]) : '',
        n > 3 ? periodKeys(ids, '__' + p[3]) : '',
        n > 4 ? periodKeys(ids, '__' + p[4]) : '',
        n > 5 ? periodKeys(ids, '__' + p[5]) : '',
        n > 6 ? periodKeys(ids, '__' + p[6]) : '',
        n > 7 ? periodKeys(ids, '__' + p[7]) : '',
        n > 8 ? periodKeys(ids, '__' + p[8]) : '',
        n > 9 ? periodKeys(ids, '__' + p[9]) : '',
        n > 10 ? periodKeys(ids, '__' + p[10]) : '',
        n > 11 ? periodKeys(ids, '__' + p[11]) : '',
        n > 12 ? periodKeys(ids, '__' + p[12]) : '',
        n > 13 ? periodKeys(ids, '__' + p[13]) : '',
        n > 14 ? periodKeys(ids, '__' + p[14]) : '',
        n > 15 ? periodKeys(ids, '__' + p[15]) : ''
      ].join('|').split('[|]').removeAll(['']);
    }
    function freeOfFet(d, expected) {
      let day = get(dayPath(d.date)).data;
      return !day.fetActive || !get(/databases/$(database)/documents/weeklyResources/$(day.weekday)).data.busyKeys.hasAny(expected);
    }
    function valid(d) {
      return d.keys().hasOnly(['title','date','roomId','periodIds','ownerUid','creatorName','createdAt','groupIds','teacherIds','eventType','isPublic','mode','onlineUrl','description','revision','updatedAt']) &&
        d.title is string && d.title.size() > 0 && d.title.size() <= 120 &&
        d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        d.roomId is string && (d.roomId == '' || d.roomId in catalog().rooms) &&
        d.groupIds is list && d.groupIds.toSet().size() == d.groupIds.size() && catalog().groups.keys().hasAll(d.groupIds) &&
        d.teacherIds is list && d.teacherIds.toSet().size() == d.teacherIds.size() && catalog().teachers.keys().hasAll(d.teacherIds) &&
        d.periodIds is list && d.periodIds.size() > 0 && d.periodIds.size() <= 16 &&
        controls().periodOrder.keys().hasAll(d.periodIds) && d.periodIds.join(',') in controls().validPeriodRanges &&
        d.eventType in ['Zëvendësim i mësimit','Konferencë','Panel','Mbrojtje publike'] &&
        d.get('description','') is string &&
        d.get('description','').split('\\s+').removeAll(['']).size() <= 500 &&
        (d.isPublic || d.get('description','') == '') &&
        d.isPublic is bool && d.mode in ['physical','online'] && d.onlineUrl is string &&
        (d.mode == 'physical' ? d.onlineUrl == '' : (d.onlineUrl.size() <= 2000 && d.onlineUrl.matches('^https?://[^ /]+.*$')));
    }
    function occupancyChange(id, d, creating, expected) {
      let path = /databases/$(database)/documents/eventDays/$(d.date);
      let before = exists(path) ? get(path).data.bookings : {};
      let after = getAfter(path).data;
      let diff = after.bookings.diff(before);
      // Exact added/removed keys plus an unchanged count of non-id values
      // ensures every affected period belongs to this reservation. This avoids
      // 16 separate map-value checks and the 1000-expression evaluation limit.
      return after.changedReservationId == id &&
        (creating ?
          (diff.addedKeys() == expected.toSet() && diff.changedKeys().size() == 0 && diff.removedKeys().size() == 0 &&
           after.bookings.values().removeAll([id]).size() == before.values().removeAll([id]).size()) :
          (diff.removedKeys() == expected.toSet() && diff.changedKeys().size() == 0 && diff.addedKeys().size() == 0 &&
           after.bookings.values().removeAll([id]).size() == before.values().removeAll([id]).size()));
    }
    function occupancyWritten(id, d) {
      let path = /databases/$(database)/documents/eventDays/$(d.date);
      return getAfter(path).data.changedReservationId == id &&
        (!exists(path) || getAfter(path).data.bookings != get(path).data.bookings);
    }
    function sameSlots(a,b) {
      return a.date == b.date && a.roomId == b.roomId && a.periodIds == b.periodIds &&
        a.get('groupIds',[]).toSet() == b.groupIds.toSet() && a.get('teacherIds',[]).toSet() == b.teacherIds.toSet();
    }
    function modificationRecorded(id, before, after) {
      let path = /databases/$(database)/documents/modificationNotifications/$(id + '__' + string(after.revision));
      return existsAfter(path);
    }
    function editOccupancy(id, before, after) {
      return sameSlots(before,after) ||
        ((resources(before).size() == 0 || occupancyWritten(id,before)) &&
         (resources(after).size() == 0 || occupancyWritten(id,after)));
    }
    function occupancyEdit(id, before, after, date) {
      let notice = /databases/$(database)/documents/modificationNotifications/$(id + '__' + string(after.revision));
      let oldKeys = before.date == date ? getAfter(notice).data.previousKeys.toSet() : [].toSet();
      let newList = after.date == date ? keys(after) : [];
      let newKeys = newList.toSet();
      let path = /databases/$(database)/documents/eventDays/$(date);
      let oldMap = exists(path) ? get(path).data.bookings : {};
      let newMap = getAfter(path).data.bookings;
      let diff = newMap.diff(oldMap);
      return (date == before.date || date == after.date) &&
        diff.addedKeys() == newKeys.difference(oldKeys) && diff.removedKeys() == oldKeys.difference(newKeys) &&
        diff.changedKeys().size() == 0 &&
        newMap.values().removeAll([id]).size() == oldMap.values().removeAll([id]).size() &&
        (date != after.date || freeOfFet(after, newList));
    }
    function publicMatches(id, d) {
      let p = getAfter(/databases/$(database)/documents/publicBookings/$(id)).data;
      return !p.keys().hasAny(['ownerUid']) && d.diff(p).affectedKeys() == ['ownerUid'].toSet();
    }
    match /resourceCatalog/{id} { allow read: if true; allow write: if false; }
    match /weeklyResources/{id} { allow read: if approved(); allow write: if false; }
    match /users/{uid} {
      allow get: if (request.auth != null && request.auth.uid == uid) || mailWorker();
      allow list, create, update, delete: if false;
    }
    match /settings/{key} {
      allow get: if approved();
      allow list, write: if false;
    }
    match /rooms/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /periods/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /calendarDays/{date} {
      allow get: if true;
      allow list: if approved();
      allow write: if false;
    }
    match /weeklyRooms/{key} {
      allow read: if approved();
      allow write: if false;
    }
    match /reservations/{reservationId} {
      allow read: if approved();
      allow create: if canBook(request.resource.data.date) && valid(request.resource.data) &&
        request.resource.data.ownerUid == request.auth.uid && request.resource.data.creatorName == request.auth.token.get('name','Mësimdhënës') &&
        request.resource.data.createdAt == request.time && !request.resource.data.keys().hasAny(['revision','updatedAt']) &&
        (resources(request.resource.data).size() == 0 || occupancyWritten(reservationId, request.resource.data)) &&
        publicMatches(reservationId, request.resource.data);
      allow update: if canBook(request.resource.data.date) && mayCancel(resource.data) && valid(request.resource.data) &&
        request.resource.data.ownerUid == resource.data.ownerUid && request.resource.data.creatorName == resource.data.creatorName &&
        request.resource.data.createdAt == resource.data.createdAt && request.resource.data.updatedAt == request.time &&
        request.resource.data.revision is int && request.resource.data.revision == resource.data.get('revision',0)+1 &&
        editOccupancy(reservationId,resource.data,request.resource.data) &&
        modificationRecorded(reservationId,resource.data,request.resource.data) && publicMatches(reservationId,request.resource.data);
      allow delete: if approved() && controls().bookingOpen == true &&
        mayCancel(resource.data) && cancellationRecorded(reservationId, resource.data) &&
        controls().slotStorage == 'resources-v2' &&
        (resources(resource.data).size() == 0 || occupancyWritten(reservationId, resource.data)) &&
        !existsAfter(/databases/$(database)/documents/publicBookings/$(reservationId));
    }
    match /modificationNotifications/{id} {
      function validModification() {
        let d = request.resource.data;
        let path = /databases/$(database)/documents/reservations/$(d.reservationId);
        let before = get(path).data;
        let after = getAfter(path).data;
        return d.keys().hasOnly(['reservationId','before','booking','previousKeys','modifiedBy','modifierName','createdAt','status']) &&
          mayCancel(before) && d.previousKeys is list && d.previousKeys.toSet() == keys(before).toSet() &&
          d.before == before && d.booking == after && after.revision == before.get('revision',0)+1 &&
          id == d.reservationId + '__' + string(after.revision) && d.modifiedBy == request.auth.uid &&
          d.modifierName == request.auth.token.get('name','Mësimdhënës') && d.createdAt == request.time &&
          d.status == (before.ownerUid == request.auth.uid ? 'recorded' : 'pending');
      }
      allow create: if approved() && controls().bookingOpen && validModification();
      allow read: if mailWorker() || (approved() && (resource.data.booking.ownerUid == request.auth.uid || get(userPath()).data.get('canCancelAll',false)));
      allow update: if mailWorker() && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'status','attempts','leaseToken','leaseUntil','sentAt','lastErrorCode','lastAttemptAt'
      ]) && request.resource.data.status in ['sending','sent','retrying','failed'];
      allow delete: if false;
    }
    match /mailSettings/{id} {
      allow get: if mailWorker() && id == 'publicEvents';
      allow list, write: if false;
    }
    match /publicEventDeliveries/{id} {
      allow read: if mailWorker();
      allow create: if mailWorker() &&
        get(/databases/$(database)/documents/publicBookings/$(request.resource.data.bookingId)).data.isPublic == true &&
        request.resource.data.recipient in get(/databases/$(database)/documents/mailSettings/publicEvents).data.recipients;
      allow update: if mailWorker() && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'status','attempts','leaseToken','leaseUntil','sentAt','lastErrorCode','lastAttemptAt'
      ]);
      allow delete: if false;
    }
    match /cancellationNotifications/{id} {
      function validCancellation() {
        let d = request.resource.data;
        let path = /databases/$(database)/documents/reservations/$(id);
        let booking = get(path).data;
        return d.keys().hasOnly(['booking','reason','cancelledBy','createdAt','status']) &&
          booking.ownerUid != request.auth.uid && mayCancel(booking) &&
          d.booking == booking && !existsAfter(path) &&
          d.cancelledBy == request.auth.uid && d.createdAt == request.time && d.status == 'pending' &&
          d.reason is string && d.reason.size() <= 2000 && d.reason.matches('(?s).*\\S.*');
      }
      allow create: if approved() && controls().bookingOpen && validCancellation();
      allow read: if mailWorker() || (approved() && (resource.data.booking.ownerUid == request.auth.uid || get(userPath()).data.get('canCancelAll',false)));
      allow update: if mailWorker() && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'status','attempts','leaseToken','leaseUntil','sentAt','lastErrorCode','lastAttemptAt'
      ]) && request.resource.data.status in ['sending','sent','retrying','failed'];
      allow delete: if false;
    }
    match /publicBookings/{id} {
      allow read: if true;
      allow create: if approved() &&
        getAfter(/databases/$(database)/documents/reservations/$(id)).data.ownerUid == request.auth.uid &&
        publicMatches(id, getAfter(/databases/$(database)/documents/reservations/$(id)).data);
      allow update: if approved() && mayCancel(get(/databases/$(database)/documents/reservations/$(id)).data) &&
        getAfter(/databases/$(database)/documents/reservations/$(id)).data.revision == get(/databases/$(database)/documents/reservations/$(id)).data.get('revision',0)+1 &&
        publicMatches(id,getAfter(/databases/$(database)/documents/reservations/$(id)).data);
      allow delete: if approved() && controls().bookingOpen == true &&
        mayCancel(get(/databases/$(database)/documents/reservations/$(id)).data) &&
        !existsAfter(/databases/$(database)/documents/reservations/$(id));
    }
    match /eventDays/{key} {
      allow read: if approved();
      function editing() {
        let id = request.resource.data.changedReservationId;
        let path = /databases/$(database)/documents/reservations/$(id);
        return exists(path) && existsAfter(path);
      }
      function validEdit() {
        let id = request.resource.data.changedReservationId;
        let path = /databases/$(database)/documents/reservations/$(id);
        let before = get(path).data;
        let after = getAfter(path).data;
        return mayCancel(before) && after.revision == before.get('revision',0)+1 && occupancyEdit(id,before,after,key);
      }
      function validChange() {
        let id = request.resource.data.changedReservationId;
        let path = /databases/$(database)/documents/reservations/$(id);
        let creating = !exists(path);
        let booking = creating ? getAfter(path).data : get(path).data;
        let expected = keys(booking);
        return key == booking.date && resources(booking).size() > 0 &&
          (creating ? booking.ownerUid == request.auth.uid : mayCancel(booking)) &&
          (creating ? existsAfter(path) : !existsAfter(path)) &&
          occupancyChange(id, booking, creating, expected) && (!creating || freeOfFet(booking, expected));
      }
      allow create, update: if approved() && controls().bookingOpen == true &&
        controls().slotStorage == 'resources-v2' &&
        request.resource.data.keys().hasOnly(['bookings', 'changedReservationId']) &&
        request.resource.data.bookings is map &&
        request.resource.data.changedReservationId is string && (editing() ? validEdit() : validChange());
      allow delete: if false;
    }
    match /roomDays/{key} { allow read: if approved(); allow write: if false; }
    // Historical per-period locks are retained for reference; daily locks are authoritative.
    match /roomSlots/{slotId} {
      allow read: if approved();
      allow write: if false;
    }
  }
}
