rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }
    function controls() {
      return get(/databases/$(database)/documents/settings/control).data;
    }
    function approved() {
      return request.auth != null &&
        exists(userPath()) &&
        get(userPath()).data.active == true &&
        get(userPath()).data.role in ['teacher', 'admin'];
    }
    function canBook(date) {
      return approved() && controls().bookingOpen == true && controls().slotStorage == 'daily-v1' &&
        date >= controls().startDate && date <= controls().endDate &&
        dayAllowed(date);
    }
    function dayPath(date) {
      return /databases/$(database)/documents/calendarDays/$(date);
    }
    function dayAllowed(date) {
      return exists(dayPath(date)) && get(dayPath(date)).data.bookingAllowed == true;
    }
    // Each weekday+room stores its occupied periods in one admin-owned doc.
    // calendarDays is admin-managed, so a client cannot forge weekday mapping.
    function freeOfFet(d) {
      let dateInfo = get(dayPath(d.date)).data;
      let key = dateInfo.weekday + '__' + d.roomId;
      return dateInfo.fetActive == false ||
        !exists(/databases/$(database)/documents/weeklyRooms/$(key)) ||
        !get(/databases/$(database)/documents/weeklyRooms/$(key)).data.busyPeriods.hasAny(d.periodIds);
    }
    // One occupancy document avoids per-operation document access limits.
    function consecutive(ids, order) {
      return (ids.size() < 1 || order[ids[0]] == order[ids[0]] + 0) &&
        (ids.size() < 2 || order[ids[1]] == order[ids[0]] + 1) &&
        (ids.size() < 3 || order[ids[2]] == order[ids[0]] + 2) &&
        (ids.size() < 4 || order[ids[3]] == order[ids[0]] + 3) &&
        (ids.size() < 5 || order[ids[4]] == order[ids[0]] + 4) &&
        (ids.size() < 6 || order[ids[5]] == order[ids[0]] + 5) &&
        (ids.size() < 7 || order[ids[6]] == order[ids[0]] + 6) &&
        (ids.size() < 8 || order[ids[7]] == order[ids[0]] + 7) &&
        (ids.size() < 9 || order[ids[8]] == order[ids[0]] + 8) &&
        (ids.size() < 10 || order[ids[9]] == order[ids[0]] + 9) &&
        (ids.size() < 11 || order[ids[10]] == order[ids[0]] + 10) &&
        (ids.size() < 12 || order[ids[11]] == order[ids[0]] + 11) &&
        (ids.size() < 13 || order[ids[12]] == order[ids[0]] + 12) &&
        (ids.size() < 14 || order[ids[13]] == order[ids[0]] + 13) &&
        (ids.size() < 15 || order[ids[14]] == order[ids[0]] + 14) &&
        (ids.size() < 16 || order[ids[15]] == order[ids[0]] + 15);
    }
    function occupancyChange(id, d, creating) {
      let path = /databases/$(database)/documents/roomDays/$(d.date + '__' + d.roomId);
      let before = exists(path) ? get(path).data.bookings : {};
      let after = getAfter(path).data;
      let diff = after.bookings.diff(before);
      // Exact added/removed keys plus an unchanged count of non-id values
      // ensures every affected period belongs to this reservation. This avoids
      // 16 separate map-value checks and the 1000-expression evaluation limit.
      return after.changedReservationId == id &&
        (creating ?
          (diff.addedKeys() == d.periodIds.toSet() && diff.changedKeys().size() == 0 && diff.removedKeys().size() == 0 &&
           after.bookings.values().removeAll([id]).size() == before.values().removeAll([id]).size()) :
          (diff.removedKeys() == d.periodIds.toSet() && diff.changedKeys().size() == 0 && diff.addedKeys().size() == 0 &&
           after.bookings.values().removeAll([id]).size() == before.values().removeAll([id]).size()));
    }
    // Legacy four-field publications remain valid while older clients reload.
    function publicMatches(id, d) {
      let p = getAfter(/databases/$(database)/documents/publicBookings/$(id)).data;
      return p.keys().hasOnly(['title', 'date', 'roomId', 'periodIds', 'creatorName', 'createdAt']) &&
        p.title == d.title && p.date == d.date &&
        p.roomId == d.roomId && p.periodIds == d.periodIds &&
        ((!p.keys().hasAny(['creatorName', 'createdAt'])) ||
          (p.keys().hasAll(['creatorName', 'createdAt']) &&
           p.creatorName == request.auth.token.get('name', 'Mësimdhënës') &&
           p.createdAt == d.createdAt));
    }
    match /users/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }
    match /settings/{key} {
      allow get: if approved();
      allow list, write: if false;
    }
    match /rooms/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /periods/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /calendarDays/{date} {
      allow get: if true;
      allow list: if approved();
      allow write: if false;
    }
    match /weeklyRooms/{key} {
      allow read: if approved();
      allow write: if false;
    }
    match /reservations/{reservationId} {
      allow read: if approved();
      allow create: if canBook(request.resource.data.date) &&
        request.resource.data.keys().hasOnly([
          'title', 'date', 'roomId', 'periodIds', 'ownerUid', 'createdAt'
        ]) &&
        request.resource.data.keys().hasAll([
          'title', 'date', 'roomId', 'periodIds', 'ownerUid', 'createdAt'
        ]) &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.title is string &&
        request.resource.data.title.size() > 0 &&
        request.resource.data.title.size() <= 120 &&
        request.resource.data.date is string &&
        request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        request.resource.data.roomId is string &&
        request.resource.data.roomId.matches('^r_[0-9a-f]{12}$') &&
        request.resource.data.periodIds is list &&
        request.resource.data.periodIds.size() >= 1 &&
        request.resource.data.periodIds.size() <= 16 &&
        request.resource.data.periodIds.toSet().size() == request.resource.data.periodIds.size() &&
        request.resource.data.createdAt == request.time &&
        exists(/databases/$(database)/documents/rooms/$(request.resource.data.roomId)) &&
        consecutive(request.resource.data.periodIds, controls().periodOrder) &&
        occupancyChange(reservationId, request.resource.data, true) &&
        freeOfFet(request.resource.data) &&
        publicMatches(reservationId, request.resource.data);
      allow update: if false;
      allow delete: if approved() && controls().bookingOpen == true &&
        resource.data.ownerUid == request.auth.uid &&
        controls().slotStorage == 'daily-v1' &&
        occupancyChange(reservationId, resource.data, false) &&
        !existsAfter(/databases/$(database)/documents/publicBookings/$(reservationId));
    }
    match /publicBookings/{id} {
      allow read: if true;
      allow create: if approved() &&
        getAfter(/databases/$(database)/documents/reservations/$(id)).data.ownerUid == request.auth.uid &&
        publicMatches(id, getAfter(/databases/$(database)/documents/reservations/$(id)).data);
      allow update: if false;
      allow delete: if approved() && controls().bookingOpen == true &&
        get(/databases/$(database)/documents/reservations/$(id)).data.ownerUid == request.auth.uid &&
        !existsAfter(/databases/$(database)/documents/reservations/$(id));
    }
    match /roomDays/{key} {
      allow read: if approved();
      function validChange() {
        let id = request.resource.data.changedReservationId;
        let path = /databases/$(database)/documents/reservations/$(id);
        let creating = !exists(path);
        let booking = creating ? getAfter(path).data : get(path).data;
        return key == booking.date + '__' + booking.roomId &&
          booking.ownerUid == request.auth.uid &&
          (creating ? existsAfter(path) : !existsAfter(path));
      }
      allow create, update: if approved() && controls().bookingOpen == true &&
        controls().slotStorage == 'daily-v1' &&
        request.resource.data.keys().hasOnly(['bookings', 'changedReservationId']) &&
        request.resource.data.bookings is map &&
        request.resource.data.changedReservationId is string && validChange();
      allow delete: if false;
    }
    // Historical per-period locks are retained for reference; daily locks are authoritative.
    match /roomSlots/{slotId} {
      allow read: if approved();
      allow write: if false;
    }
  }
}
